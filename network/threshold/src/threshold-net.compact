// Nightcast threshold network, stage 3b (not yet deployed): the value path, the registry, the money,
// the stake pool link and the recommended successor.
//
// A committee of n operators (positions 1..n) shares one key that nobody holds. Any t of them
// give the same random value for a request; fewer than t can't work it out. The design, the
// decisions and the first review are in the design doc ("Nightcast threshold network: design").
//
//   registry    register (a key, a payout address, a bond), leave, withdraw. Independent operators
//               wait in a queue; the house's operators (named when the contract is deployed) only
//               fill the seats independents can't.
//   pool link   An operator that isn't the house's counts as independent (and queues) only once
//               `linkPool` has seen a stake pool's Ed25519 key sign for it, AND that key is on
//               the list of pool keys fixed when the contract was deployed (a Merkle root:
//               anyone can rebuild the list from Cardano and compare). The contract can't read
//               Cardano, so without the list anyone could make keys and call them pools. One
//               operator per pool key at a time.
//   epochs      openEpoch sizes the next committee from the number of independents (1 of 1 with
//               none, 3 of 5 with 1 to 3, 4 of 7 from 4), and `seat` fills it: independents from
//               the front of the queue (the longest-waiting first; a committee that has served
//               goes to the back), then the house. No randomness, nothing anyone chooses.
//   ceremony    dealCommit, dealShare, finish: a dealer PROVES its deal as it posts it (no
//               complaints); the group key is the sum of the dealers that finished. A seat that
//               didn't finish a failed ceremony loses part of its bond.
//   requests    request (the id comes from the contract's counter, the input point H is fixed
//               then; the requester pays the fee), answer, finalise (any t answers, one value; a
//               bounty to whoever sends it), settle, claim
//   money       After a request's deadline, `settle`: if it has its value, the fee is shared
//               equally by the seats that answered in time (so answering fast can't shut the
//               others out), with any penalties in the pot; if not, it is void: the requester
//               gets the fee back plus a slice of the bond of every seat that didn't answer. A
//               void request keeps its H and stays answerable: silence buys no second roll.
//               Seats that miss too often, or whose bond fell below the minimum, are stood down
//               when the next epoch opens and must register again.
//   successor   Nothing in this contract can be changed, and it can't move anyone or anything
//               to another contract. `recommend` only RECORDS an address: when two-thirds of
//               the serving committee's seats name the same address in two served epochs in a
//               row, it becomes the recommended successor. Operators and consumers move, or
//               don't, by their own choice.
//
//   share key of position i    pk_i = A0 + i·A1 + i²·A2 + i³·A3     (A_k: the dealers' sums)
//   its answer to a request    Γ_i  = sk_i·H, proved against pk_i
//   the value, from any t      Γ*   = Σ c_i·Γ_i,  c_i = 720·Π_{j≠i} j/(j-i)  →  720·sk·H
//                              output = SHA-256("nightcast:threshold:v1" || Γ*)
// 720 = 6! clears every denominator for positions 1..7, whatever the committee's size, so one
// rule serves 1 of 1, 3 of 5 and 4 of 7. A negative c_i is applied as (r - |c_i|).
//
// Compact 0.36.1. Notes for whoever changes this: transientHash can't take a JubjubPoint (hash its
// coordinates); never use constructJubjubPoint on anything a caller sends (it doesn't check the
// curve); hashToCurve may have several valid outputs, so H is worked out once, by `request`.

pragma language_version >= 0.28;

import CompactStandardLibrary;

export enum Phase { seating, dealing, serving, failed }
export enum Status { pending, fulfilled }

export struct Operator {
  // Its key: its id is this key's hash, parcels are encrypted to it, and it proves the secret.
  key: JubjubPoint;
  // Where its withdrawn bond (and, from stage 2b, its fees) go.
  payout: UserAddress;
  // One of the house's operators (named at deploy): it never queues, and fills only spare seats.
  house: Boolean;
  active: Boolean;
  // Waiting in the queue for a seat (independents only).
  queued: Boolean;
  // The newest epoch opened when it left (0 while active): its bond waits two served epochs.
  leftAt: Uint<64>;
}

export struct Committee {
  n: Uint<8>;
  t: Uint<8>;
  // Seats for independents (positions 1..indepSeats, from the queue); the rest are the house's.
  indepSeats: Uint<8>;
  phase: Phase;
  // Seats taken, and dealers that finished (posted every parcel).
  seated: Uint<8>;
  dealt: Uint<8>;
  // The ceremony must finish by then (seconds since the epoch), or it fails.
  dealBy: Uint<64>;
  // When it began serving (0 until then). The next epoch can open one epoch length later.
  since: Uint<64>;
}

export struct Parcel {
  r: JubjubPoint;
  c: Field;
}

export struct Request {
  // The committee that answers it: the one serving when it was made.
  epoch: Uint<64>;
  status: Status;
  requester: Bytes<32>;
  tag: Bytes<32>;
  // H, fixed when the request was made.
  point: JubjubPoint;
  deadline: Uint<64>;
  // Shares posted so far, and how many of them before the deadline (those are paid).
  answers: Uint<8>;
  timely: Uint<8>;
  // What the request still holds of its fee, and where it goes back if the request is void.
  fee: Uint<128>;
  refundTo: UserAddress;
  // Settled: the fee has been shared out or refunded. Void: settled without a value. A void
  // request keeps its H and can still be answered and finalised.
  settled: Boolean;
  voided: Boolean;
  // The random value; all zeros until fulfilled.
  output: Bytes<32>;
}

struct IdPreimage {
  domain: Bytes<32>;
  deployment: ContractAddress;
  number: Field;
  requester: Bytes<32>;
  tag: Bytes<32>;
}

struct LinkPreimage {
  domain: Bytes<32>;
  deployment: ContractAddress;
  operator: Bytes<32>;
  number: Field;
}

// One step up the list's Merkle tree: the node beside this one, and whether this one is the
// right-hand child.
export struct Step {
  sibling: Field;
  right: Boolean;
}

struct OutputPreimage {
  domain: Bytes<32>;
  gamma: JubjubPoint;
}

// The epoch being served (0: none yet), and the newest epoch opened.
export ledger current: Uint<64>;
export ledger opened: Uint<64>;
export ledger committees: Map<Uint<64>, Committee>;
// Operators by id, their bonds (in slots), and how many are active.
export ledger operators: Map<Bytes<32>, Operator>;
export ledger bonds: Map<Bytes<32>, Counter>;
export ledger independents: Uint<16>;
export ledger houseActive: Uint<8>;
// The independents' queue: entries head..tail-1. A stale entry (its operator left, or was seated
// through a newer entry) is skipped when it reaches the front.
export ledger queue: Map<Uint<64>, Bytes<32>>;
export ledger head: Uint<64>;
export ledger tail: Uint<64>;
// Stake pools, by pool key id (a hash of the key): the key itself, the operator it is linked to
// now, and how many times it has linked (each link signs the next number, so an old signature
// can't be used again). And each linked operator's pool key id.
export ledger poolKeys: Map<Bytes<32>, Curve25519Point>;
export ledger poolOperator: Map<Bytes<32>, Bytes<32>>;
export ledger poolLinks: Map<Bytes<32>, Uint<64>>;
export ledger poolOf: Map<Bytes<32>, Bytes<32>>;
// The epoch served before the current one (0: none). Recommending a successor: the seats that
// have named an address in their epoch, by (epoch, position); the count for each (epoch,
// address); the address two-thirds of an epoch's seats named and that epoch; and the
// recommended successor (all zeros: none) with the epoch it was confirmed in.
export ledger previous: Uint<64>;
export ledger ballots: Map<Field, Boolean>;
export ledger votes: Map<Bytes<32>, Uint<8>>;
export ledger backed: Bytes<32>;
export ledger backedEpoch: Uint<64>;
export ledger successor: Bytes<32>;
export ledger successorEpoch: Uint<64>;
// The last epoch each operator was seated in.
export ledger lastSeat: Map<Bytes<32>, Uint<64>>;
// Bond slots taken as penalties (stage 2b pays them to the operators that behaved).
export ledger pot: Uint<64>;
// (epoch, position) -> the operator seated there, and its key; (epoch, dealer, k) -> A_k;
// (epoch, dealer) -> it has committed / parcels sent / finished; (epoch, dealer, to) -> the
// parcel; (epoch, k) -> the group's A_k.
export ledger members: Map<Field, Bytes<32>>;
export ledger seats: Map<Field, JubjubPoint>;
export ledger finished: Map<Field, Boolean>;
export ledger commitments: Map<Field, JubjubPoint>;
export ledger committed: Map<Field, Boolean>;
export ledger sent: Map<Field, Uint<8>>;
export ledger parcels: Map<Field, Parcel>;
export ledger aggregate: Map<Field, JubjubPoint>;
export ledger requests: Map<Bytes<32>, Request>;
export ledger shares: Map<Bytes<32>, JubjubPoint>;
// The shares that landed before their request's deadline.
export ledger timelyShares: Map<Bytes<32>, Boolean>;
export ledger nextRequest: Uint<64>;
// What each operator has earned and not yet claimed (atoms); requests it missed since it was
// last queued or checked; and atoms left over from sharing fees (they stay in the contract).
export ledger earned: Map<Bytes<32>, Uint<128>>;
export ledger missed: Map<Bytes<32>, Uint<16>>;
export ledger dust: Uint<128>;
// Scratch for `settle`: what a void request's refund has gathered so far (0 between calls).
export ledger refunding: Uint<128>;

export sealed ledger minWindow: Uint<64>;
export sealed ledger maxWindow: Uint<64>;
// NIGHT atoms per bond slot, the smallest bond, and the slots a seat loses for not finishing a
// failed ceremony.
export sealed ledger collateralPerSlot: Uint<128>;
export sealed ledger minBondSlots: Uint<16>;
export sealed ledger ceremonyPenalty: Uint<16>;
// How long a committee serves before the next epoch can open (seconds).
export sealed ledger epochSecs: Uint<64>;
// What a request costs, and the part of it that goes to whoever sends `finalise`.
export sealed ledger requestFee: Uint<128>;
export sealed ledger finaliseBounty: Uint<128>;
// The slots a seat loses for not answering a request that goes void, and how many requests a
// seat may miss in a term before it is stood down.
export sealed ledger missPenalty: Uint<16>;
export sealed ledger allowedMisses: Uint<16>;
// The house's operator ids (unused entries are zero).
export sealed ledger house: Vector<4, Bytes<32>>;
// The root of the list of stake pool keys that can back an operator (a 13-level Merkle tree of
// poolLeafOf(pool key id), empty places 0), fixed for the life of the contract.
export sealed ledger poolsRoot: Field;

// An operator's secret (its key is that times G).
witness operatorSecret(): Field;
// A dealer's polynomial a_0..a_3 (zeros past the threshold), a share of it, and a one-time number.
witness coefficients(): Vector<4, Field>;
witness shareFor(i: Uint<8>): Field;
witness ephemeral(i: Uint<8>): Field;
// A position's share of the group key: the sum of what the finished dealers sent it.
witness shareSecret(): Field;
// |c_i| for position i with the others a, b, c (0: no such other).
witness coefficient(i: Uint<8>, a: Uint<8>, b: Uint<8>, c: Uint<8>): Uint<64>;
witness requesterSecret(): Bytes<32>;
// total / k, rounded down (checked in the circuit: there is no division).
witness quotient(total: Uint<128>, k: Uint<8>): Uint<128>;
// Where a pool key sits in the list: the 13 steps from its leaf up to the root.
witness poolPath(pool: Bytes<32>): Vector<13, Step>;

constructor(minSecs: Uint<64>, maxSecs: Uint<64>, epoch: Uint<64>, collateral: Uint<128>, minBond: Uint<16>, penalty: Uint<16>, fee: Uint<128>, bounty: Uint<128>, miss: Uint<16>, misses: Uint<16>, houseIds: Vector<4, Bytes<32>>, pools: Field) {
  assert(minSecs >= 60, "minWindow must be at least 60 seconds");
  assert(minSecs < maxSecs, "minWindow must be below maxWindow");
  assert(maxSecs <= 2592000, "maxWindow must be at most 30 days");
  assert(collateral > 0, "a bond slot must be worth something");
  assert(minBond >= 1 && penalty <= minBond, "the penalty can't be more than the smallest bond");
  minWindow = disclose(minSecs);
  maxWindow = disclose(maxSecs);
  collateralPerSlot = disclose(collateral);
  minBondSlots = disclose(minBond);
  ceremonyPenalty = disclose(penalty);
  assert(epoch >= maxSecs, "an epoch is at least as long as the longest window");
  assert(bounty <= fee, "the bounty comes out of the fee");
  assert(miss <= minBond, "the miss penalty can't be more than the smallest bond");
  epochSecs = disclose(epoch);
  requestFee = disclose(fee);
  finaliseBounty = disclose(bounty);
  missPenalty = disclose(miss);
  allowedMisses = disclose(misses);
  house = disclose(houseIds);
  poolsRoot = disclose(pools);
}

// ---------------------------------------------------------------- pure helpers

export pure circuit seatKey(e: Uint<64>, i: Uint<8>): Field {
  return (e as Field) * 8 + (i as Field);
}

export pure circuit cellKey(e: Uint<64>, d: Uint<8>, k: Uint<8>): Field {
  return (e as Field) * 64 + (d as Field) * 8 + (k as Field);
}

// An operator's id: a hash of its key.
export pure circuit keyIdOf(key: JubjubPoint): Bytes<32> {
  return persistentHash<[Bytes<32>, Field, Field]>([pad(32, "nightcast:operator-key:v1"), jubjubPointX(key), jubjubPointY(key)]);
}

pure circuit toUser(a: UserAddress): Either<ContractAddress, UserAddress> {
  return right<ContractAddress, UserAddress>(a);
}

export pure circuit shareId(id: Bytes<32>, i: Uint<8>): Bytes<32> {
  return persistentHash<[Bytes<32>, Bytes<32>, Field]>([pad(32, "nightcast:threshold-share:v1"), id, i as Field]);
}

export pure circuit requestIdOf(deployment: ContractAddress, number: Uint<64>, requester: Bytes<32>, tag: Bytes<32>): Bytes<32> {
  return persistentHash<IdPreimage>(IdPreimage { domain: pad(32, "nightcast:threshold-id:v1"), deployment: deployment, number: number as Field, requester: requester, tag: tag });
}

// A pool key's id; its leaf in the list; and a node of the list's tree.
export pure circuit poolIdOf(pool: Curve25519Point): Bytes<32> {
  return persistentHash<Curve25519Point>(pool);
}

export pure circuit poolLeafOf(pool: Bytes<32>): Field {
  return transientHash<[Field, Bytes<32>]>([1 as Field, pool]);
}

export pure circuit poolNodeOf(left: Field, right: Field): Field {
  return transientHash<[Field, Field, Field]>([2 as Field, left, right]);
}

// What a pool's key signs (the 32 bytes themselves, plain Ed25519) to back an operator in this
// deployment: `number` is how many times the pool has linked before.
export pure circuit linkMessageOf(deployment: ContractAddress, operator: Bytes<32>, number: Uint<64>): Bytes<32> {
  return persistentHash<LinkPreimage>(LinkPreimage { domain: pad(32, "nightcast:pool-link:v1"), deployment: deployment, operator: operator, number: number as Field });
}

export pure circuit voteKey(e: Uint<64>, next: Bytes<32>): Bytes<32> {
  return persistentHash<[Bytes<32>, Field, Bytes<32>]>([pad(32, "nightcast:successor-vote:v1"), e as Field, next]);
}

export pure circuit requesterCommitmentOf(secret: Bytes<32>): Bytes<32> {
  return persistentHash<[Bytes<32>, Bytes<32>]>([pad(32, "nightcast:requester:v0"), secret]);
}

export pure circuit outputOf(gamma: JubjubPoint): Bytes<32> {
  return persistentHash<OutputPreimage>(OutputPreimage { domain: pad(32, "nightcast:threshold:v1"), gamma: gamma });
}

// The pad for dealer d's parcel to position i in epoch e, from the point they share (by its
// coordinates). 1852400484 is this contract's tag.
export pure circuit padOf(k: JubjubPoint, e: Uint<64>, d: Uint<8>, i: Uint<8>): Field {
  return transientHash<[Field, Field, Field, Field, Field, Field]>([1852400484 as Field, jubjubPointX(k), jubjubPointY(k), e as Field, d as Field, i as Field]);
}

pure circuit same(a: JubjubPoint, b: JubjubPoint): Boolean {
  return jubjubPointX(a) == jubjubPointX(b) && jubjubPointY(a) == jubjubPointY(b);
}

pure circuit isIdentity(a: JubjubPoint): Boolean {
  return jubjubPointX(a) == (0 as Field) && jubjubPointY(a) == (1 as Field);
}

pure circuit identity(): JubjubPoint {
  return ecMulGenerator((0 as Field) as JubjubScalar);
}

pure circuit small(i: Uint<8>): JubjubScalar {
  return (i as Field) as JubjubScalar;
}

// Horner: c0 + i·c1 + i²·c2 + i³·c3.
export pure circuit evalCommitments(c0: JubjubPoint, c1: JubjubPoint, c2: JubjubPoint, c3: JubjubPoint, i: Uint<8>): JubjubPoint {
  const s = small(i);
  return ecAdd(ecMul(ecAdd(ecMul(ecAdd(ecMul(c3, s), c2), s), c1), s), c0);
}

// |a - i|, or 1 when there is no such other position (a = 0).
pure circuit distOr1(a: Uint<8>, i: Uint<8>): Field {
  return a == 0 ? (1 as Field) : (a > i ? (a - i) as Field : (i - a) as Field);
}

pure circuit orOne(a: Uint<8>): Field {
  return a == 0 ? (1 as Field) : (a as Field);
}

// ---------------------------------------------------------------- the registry

// NIGHT atoms in `n` bond slots (fails rather than wrapping).
circuit slotsValue(n: Uint<64>): Uint<128> {
  return ((n as Field) * (collateralPerSlot as Field)) as Uint<128>;
}

circuit isHouse(id: Bytes<32>): Boolean {
  const h = house;
  return id == h[0] || id == h[1] || id == h[2] || id == h[3];
}

// Join (or rejoin after leaving) as an operator, with `slots` more bond paid in by the caller.
// Proving the key's secret rules out the identity, odd points and keys nobody can use. An
// operator that isn't the house's joins the back of the queue if a stake pool is linked to it;
// if not, it waits for `linkPool`.
export circuit register(payout: UserAddress, slots: Uint<16>): [] {
  const key = disclose(ecMulGenerator(operatorSecret() as JubjubScalar));
  assert(!isIdentity(key), "identity key not allowed");
  const id = keyIdOf(key);
  const n = disclose(slots);
  const hs = isHouse(id);
  if (operators.member(id)) {
    assert(!operators.lookup(id).active, "already registered");
  } else {
    bonds.insertDefault(id);
  }
  if (n > 0) {
    receiveUnshielded(nativeToken(), slotsValue(n));
    bonds.lookup(id).increment(n);
  }
  assert(!bonds.lookup(id).lessThan(minBondSlots), "the bond is below the minimum");
  const linked = poolOf.member(id);
  operators.insert(id, Operator { key: key, payout: disclose(payout), house: hs, active: true, queued: !hs && linked, leftAt: 0 });
  if (hs) {
    houseActive = (houseActive + 1) as Uint<8>;
  } else {
    if (linked) {
      independents = (independents + 1) as Uint<16>;
      queue.insert(tail, id);
      tail = (tail + 1) as Uint<64>;
    }
  }
}

// Anyone links a stake pool to a registered operator, with the pool key's signature over
// linkMessageOf(this contract, the operator, the pool's link count). The key must be on the
// contract's list. The operator then counts as independent and joins the queue. A pool backs one
// operator at a time: it can move to another only once the one it backs has left or been stood
// down (that one is then unlinked).
export circuit linkPool(operator: Bytes<32>, sig: Ed25519Signature, pool: Curve25519Point): [] {
  const id = disclose(operator);
  assert(operators.member(id), "not a registered operator");
  const o = operators.lookup(id);
  assert(o.active, "that operator has left");
  assert(!o.house, "the house's operators need no pool");
  assert(!poolOf.member(id), "that operator is linked to a pool");
  const key = disclose(pool);
  const pid = poolIdOf(key);
  const top = fold((acc, s) => s.right ? poolNodeOf(s.sibling, acc) : poolNodeOf(acc, s.sibling), poolLeafOf(pid), poolPath(pid));
  assert(disclose(top) == poolsRoot, "that key isn't on this contract's list of stake pools");
  const n = poolLinks.member(pid) ? poolLinks.lookup(pid) : 0;
  if (poolOperator.member(pid)) {
    const old = poolOperator.lookup(pid);
    assert(!operators.lookup(old).active, "that pool's operator is still active");
    poolOf.remove(old);
  }
  assert(ed25519Verify<32>(linkMessageOf(kernel.self(), id, n), disclose(sig), key), "the pool's key didn't sign for this operator");
  poolKeys.insert(pid, key);
  poolOperator.insert(pid, id);
  poolLinks.insert(pid, (n + 1) as Uint<64>);
  poolOf.insert(id, pid);
  operators.insert(id, Operator { ...o, queued: true });
  independents = (independents + 1) as Uint<16>;
  queue.insert(tail, id);
  tail = (tail + 1) as Uint<64>;
}

// Stop being seated in new committees. A seat already held keeps its duties.
export circuit leave(): [] {
  const id = disclose(keyIdOf(ecMulGenerator(operatorSecret() as JubjubScalar)));
  assert(operators.member(id), "not a registered operator");
  const o = operators.lookup(id);
  assert(o.active, "already left");
  operators.insert(id, Operator { ...o, active: false, queued: false, leftAt: opened });
  if (o.house) {
    houseActive = (houseActive - 1) as Uint<8>;
  } else {
    if (poolOf.member(id)) {
      independents = (independents - 1) as Uint<16>;
    }
  }
}

// Take `slots` of bond back, to the payout address. An active operator keeps the minimum; one
// that has left can take it all once two epochs opened after it left are being served.
export circuit withdraw(slots: Uint<16>): [] {
  const id = disclose(keyIdOf(ecMulGenerator(operatorSecret() as JubjubScalar)));
  assert(operators.member(id), "not a registered operator");
  const o = operators.lookup(id);
  const n = disclose(slots);
  assert(n > 0, "nothing to withdraw");
  assert(!bonds.lookup(id).lessThan(n), "not that much bond");
  bonds.lookup(id).decrement(n);
  if (o.active) {
    assert(!bonds.lookup(id).lessThan(minBondSlots), "an active operator keeps the minimum bond");
  } else {
    assert(current >= o.leftAt + 2, "the bond waits until two epochs opened after leaving are served");
  }
  sendUnshielded(nativeToken(), slotsValue(n), toUser(o.payout));
}

// ---------------------------------------------------------------- the ceremony

// Epoch e's committee is done seating: go through its seats. With `penalise` (a failed
// ceremony), a seat that didn't finish dealing first loses part of its bond. A seat that missed
// too many requests, or whose bond is now below the minimum, is stood down (it must register
// again). Otherwise an independent goes back in the queue.
circuit requeue(e: Uint<64>, penalise: Boolean): [] {
  for (const k of 0..7) {
    const sk = seatKey(e, (k + 1) as Uint<8>);
    if (members.member(sk)) {
      const id = members.lookup(sk);
      if (penalise && !finished.member(sk) && !bonds.lookup(id).lessThan(ceremonyPenalty)) {
        bonds.lookup(id).decrement(ceremonyPenalty);
        pot = (pot + ceremonyPenalty) as Uint<64>;
      }
      const o = operators.lookup(id);
      const m = missed.member(id) ? missed.lookup(id) : 0;
      missed.insert(id, 0);
      if (o.active && (m > allowedMisses || bonds.lookup(id).lessThan(minBondSlots))) {
        operators.insert(id, Operator { ...o, active: false, queued: false, leftAt: opened });
        if (o.house) {
          houseActive = (houseActive - 1) as Uint<8>;
        } else {
          if (poolOf.member(id)) {
            independents = (independents - 1) as Uint<16>;
          }
        }
      } else {
        if (o.active && !o.house && !o.queued && poolOf.member(id)) {
          operators.insert(id, Operator { ...o, queued: true });
          queue.insert(tail, id);
          tail = (tail + 1) as Uint<64>;
        }
      }
    }
  }
}

// Anyone opens the next epoch's committee, with its ceremony due by `dealBy`. Only when the
// newest epoch opened has failed, or is being served and has served its epoch length. The committees that are done seating (the
// failed one, then the one serving) rejoin the back of the queue, and the size follows the
// number of independents: none 1 of 1; 1 to 3, 3 of 5; 4 or more, 4 of 7. Independents take as
// many seats as there are of them; the house fills the rest, so from 3 independents it is
// below the threshold, and from 7 it has no seat.
export circuit openEpoch(dealBy: Uint<64>): Uint<64> {
  const by = disclose(dealBy);
  assert(by >= maxWindow, "the ceremony's deadline is out of range");
  assert(blockTimeLt(by - minWindow), "the ceremony's deadline is too soon");
  assert(blockTimeGte(by - maxWindow), "the ceremony's deadline is too far away");
  if (opened != current) {
    assert(committees.lookup(opened).phase == Phase.failed, "the newest epoch's ceremony is still running");
    requeue(opened, true);
  } else {
    if (current > 0) {
      assert(blockTimeGte((committees.lookup(current).since + epochSecs) as Uint<64>), "the serving epoch isn't over");
    }
  }
  if (current > 0) {
    requeue(current, false);
  }
  const i = independents;
  const n = (i == 0 ? 1 : (i <= 3 ? 5 : 7)) as Uint<8>;
  const t = (i == 0 ? 1 : (i <= 3 ? 3 : 4)) as Uint<8>;
  const mine = (i >= 7 ? 7 : i) as Uint<8>;
  assert(houseActive >= n - mine, "not enough house operators to fill the committee");
  const e = (opened + 1) as Uint<64>;
  opened = e;
  committees.insert(e, Committee { n: n, t: t, indepSeats: mine, phase: Phase.seating, seated: 0, dealt: 0, dealBy: by, since: 0 });
  return e;
}

// Operator `id` takes the next position of epoch e's committee.
circuit place(e: Uint<64>, c: Committee, id: Bytes<32>, o: Operator): [] {
  const pos = (c.seated + 1) as Uint<8>;
  members.insert(seatKey(e, pos), id);
  seats.insert(seatKey(e, pos), o.key);
  lastSeat.insert(id, e);
  operators.insert(id, Operator { ...o, queued: false });
  committees.insert(e, Committee { ...c, seated: pos, phase: pos == c.n ? Phase.dealing : Phase.seating });
}

// Anyone fills the next seat of epoch e's committee. While independents' seats are open, it is
// the front of the queue (a stale entry is dropped, and the call does nothing more). After
// them, a house operator: `houseSlot` says which of the house's four, and it must be active and
// not yet seated in this epoch.
export circuit seat(e: Uint<64>, houseSlot: Uint<8>): [] {
  const ee = disclose(e);
  assert(committees.member(ee), "no such epoch");
  const c = committees.lookup(ee);
  assert(c.phase == Phase.seating, "that committee isn't seating");
  if (c.seated < c.indepSeats) {
    assert(head < tail, "the queue is empty");
    const id = queue.lookup(head);
    head = (head + 1) as Uint<64>;
    const o = operators.lookup(id);
    if (o.active && o.queued) {
      place(ee, c, id, o);
    }
  } else {
    const hh = disclose(houseSlot);
    assert(hh < 4, "the house has four slots");
    const h = house;
    const id = hh == 0 ? h[0] : (hh == 1 ? h[1] : (hh == 2 ? h[2] : h[3]));
    assert(operators.member(id), "that house operator isn't registered");
    const o = operators.lookup(id);
    assert(o.active, "that house operator has left");
    assert(!lastSeat.member(id) || lastSeat.lookup(id) != ee, "that house operator is already seated");
    place(ee, c, id, o);
  }
}

// The operator seated at position d posts its polynomial's commitments: each A_k is proved to be a secret
// coefficient times G, and past the threshold it must be the identity (a zero coefficient).
export circuit dealCommit(e: Uint<64>, d: Uint<8>, c: Vector<4, JubjubPoint>): [] {
  const ee = disclose(e);
  const dd = disclose(d);
  const cc = disclose(c);
  assert(committees.member(ee), "no such epoch");
  const com = committees.lookup(ee);
  assert(com.phase == Phase.dealing, "that committee isn't dealing");
  assert(dd >= 1 && dd <= com.n, "no such position");
  assert(disclose(same(ecMulGenerator(operatorSecret() as JubjubScalar), seats.lookup(seatKey(ee, dd)))), "not this position's holder");
  assert(!committed.member(seatKey(ee, dd)), "this position has dealt");
  committed.insert(seatKey(ee, dd), true);
  sent.insert(seatKey(ee, dd), 0);
  const a = coefficients();
  for (const k of 0..4) {
    const kk = k as Uint<8>;
    if (kk < com.t) {
      assert(disclose(same(ecMulGenerator(a[k] as JubjubScalar), cc[k])), "not this coefficient's commitment");
    } else {
      assert(isIdentity(cc[k]), "a commitment past the threshold must be the identity");
    }
    commitments.insert(cellKey(ee, dd, kk), cc[k]);
  }
}

// Dealer d posts position i's share, encrypted to i's seat key, and proves it is the right
// share. With its last parcel the dealer has finished: its commitments join the group's.
export circuit dealShare(e: Uint<64>, d: Uint<8>, i: Uint<8>): [] {
  const ee = disclose(e);
  const dd = disclose(d);
  const ii = disclose(i);
  assert(committees.member(ee), "no such epoch");
  const com = committees.lookup(ee);
  assert(com.phase == Phase.dealing, "that committee isn't dealing");
  assert(dd >= 1 && dd <= com.n && ii >= 1 && ii <= com.n, "no such position");
  assert(committed.member(seatKey(ee, dd)), "that dealer hasn't posted its commitments");
  assert(!parcels.member(cellKey(ee, dd, ii)), "already sent");
  const s = shareFor(ii);
  const x = ephemeral(ii);
  const expected = evalCommitments(commitments.lookup(cellKey(ee, dd, 0)), commitments.lookup(cellKey(ee, dd, 1)), commitments.lookup(cellKey(ee, dd, 2)), commitments.lookup(cellKey(ee, dd, 3)), ii);
  assert(disclose(same(ecMulGenerator(s as JubjubScalar), expected)), "not this dealer's share for that position");
  const k = ecMul(seats.lookup(seatKey(ee, ii)), x as JubjubScalar);
  parcels.insert(cellKey(ee, dd, ii), Parcel { r: disclose(ecMulGenerator(x as JubjubScalar)), c: disclose(s + padOf(k, ee, dd, ii)) });
  const count = (sent.lookup(seatKey(ee, dd)) + 1) as Uint<8>;
  sent.insert(seatKey(ee, dd), count);
  if (count == com.n) {
    for (const j of 0..4) {
      const jj = j as Uint<8>;
      const mine = commitments.lookup(cellKey(ee, dd, jj));
      if (aggregate.member(seatKey(ee, jj))) {
        aggregate.insert(seatKey(ee, jj), ecAdd(aggregate.lookup(seatKey(ee, jj)), mine));
      } else {
        aggregate.insert(seatKey(ee, jj), mine);
      }
    }
    finished.insert(seatKey(ee, dd), true);
    committees.insert(ee, Committee { ...com, dealt: (com.dealt + 1) as Uint<8> });
  }
}

// Anyone ends epoch e's ceremony, giving the time now (checked to within minWindow). Once every
// dealer has finished, or once its deadline has passed with at least t finished, the committee
// serves from now (every seat holds shares from the finished dealers, whether or not it dealt).
// Past the deadline with fewer, it has failed, and the epoch before carries on.
export circuit finish(e: Uint<64>, now: Uint<64>): Boolean {
  const ee = disclose(e);
  const at = disclose(now);
  assert(at >= minWindow, "that time is out of range");
  assert(blockTimeGte(at - minWindow) && blockTimeLt((at + minWindow) as Uint<64>), "that isn't the time now");
  assert(committees.member(ee), "no such epoch");
  const c = committees.lookup(ee);
  assert(c.phase == Phase.seating || c.phase == Phase.dealing, "that ceremony is over");
  if (c.phase == Phase.dealing && c.dealt == c.n) {
    committees.insert(ee, Committee { ...c, phase: Phase.serving, since: at });
    previous = current;
    current = ee;
    return true;
  }
  assert(blockTimeGte(c.dealBy), "the ceremony isn't finished and its deadline hasn't passed");
  if (c.phase == Phase.dealing && c.dealt >= c.t) {
    committees.insert(ee, Committee { ...c, phase: Phase.serving, since: at });
    previous = current;
    current = ee;
    return true;
  }
  committees.insert(ee, Committee { ...c, phase: Phase.failed });
  return false;
}

// Position i's share key in epoch e, from the group's commitments.
circuit keyOf(e: Uint<64>, i: Uint<8>): JubjubPoint {
  return evalCommitments(aggregate.lookup(seatKey(e, 0)), aggregate.lookup(seatKey(e, 1)), aggregate.lookup(seatKey(e, 2)), aggregate.lookup(seatKey(e, 3)), i);
}

// ---------------------------------------------------------------- requests

// Ask the serving committee for a random value. The id comes from the contract's own counter
// (and the caller's requester secret and tag), so it can't be shaped, and the input point H is
// fixed now. The caller pays the fee; `refundTo` gets it back, and more, if the request goes void.
// Returns the request id.
export circuit request(tag: Bytes<32>, deadline: Uint<64>, refundTo: UserAddress): Bytes<32> {
  const d = disclose(deadline);
  assert(current > 0, "no committee is serving yet");
  assert(d >= maxWindow, "deadline is out of range");
  assert(blockTimeLt(d - minWindow), "deadline is too soon");
  assert(blockTimeGte(d - maxWindow), "deadline is too far away");
  const requester = disclose(requesterCommitmentOf(requesterSecret()));
  const id = requestIdOf(kernel.self(), nextRequest, requester, disclose(tag));
  nextRequest = (nextRequest + 1) as Uint<64>;
  if (requestFee > 0) {
    receiveUnshielded(nativeToken(), requestFee);
  }
  requests.insert(id, Request {
    epoch: current,
    status: Status.pending,
    requester: requester,
    tag: disclose(tag),
    point: hashToCurve<[Bytes<32>, Bytes<32>]>([pad(32, "nightcast:h2c:v0"), id]),
    deadline: d,
    answers: 0,
    timely: 0,
    fee: requestFee,
    refundTo: disclose(refundTo),
    settled: false,
    voided: false,
    output: default<Bytes<32>>
  });
  return id;
}

// Position i of the request's committee posts its share Γ_i = sk_i·H, proving sk_i is its share
// of the group key. Accepted whenever it comes; one that lands before the deadline is paid.
export circuit answer(id: Bytes<32>, i: Uint<8>): [] {
  const rid = disclose(id);
  const ii = disclose(i);
  assert(requests.member(rid), "unknown request");
  const r = requests.lookup(rid);
  assert(ii >= 1 && ii <= committees.lookup(r.epoch).n, "no such position");
  const sid = shareId(rid, ii);
  assert(!shares.member(sid), "already answered");
  const sk = shareSecret();
  assert(disclose(same(ecMulGenerator(sk as JubjubScalar), keyOf(r.epoch, ii))), "not this position's share");
  shares.insert(sid, disclose(ecMul(r.point, sk as JubjubScalar)));
  if (blockTimeLt(r.deadline)) {
    timelyShares.insert(sid, true);
    requests.insert(rid, Request { ...r, answers: (r.answers + 1) as Uint<8>, timely: (r.timely + 1) as Uint<8> });
  } else {
    requests.insert(rid, Request { ...r, answers: (r.answers + 1) as Uint<8> });
  }
}

// One term of the combination, ±|c_i|·Γ_i, or the identity when the slot isn't used.
circuit term(use: Boolean, rid: Bytes<32>, i: Uint<8>, a: Uint<8>, b: Uint<8>, c: Uint<8>, negative: Boolean): JubjubPoint {
  if (use) {
    const sid = shareId(rid, i);
    assert(shares.member(sid), "a share is missing");
    const m = disclose(coefficient(i, a, b, c));
    assert((m as Field) * distOr1(a, i) * distOr1(b, i) * distOr1(c, i) == (720 as Field) * orOne(a) * orOne(b) * orOne(c), "wrong coefficient");
    const r = 6554484396890773809930967563523245729705921265872317281365359162392183254199 as Field;
    const scalar = negative ? r - (m as Field) : (m as Field);
    return ecMul(shares.lookup(sid), scalar as JubjubScalar);
  }
  return identity();
}

// Anyone combines t answers: the committee's t positions in increasing order, then zeros. Any t
// give the same value. `bountyTo` is paid the bounty out of the fee the request still holds.
export circuit finalise(id: Bytes<32>, s: Vector<4, Uint<8>>, bountyTo: UserAddress): Bytes<32> {
  const rid = disclose(id);
  const p = disclose(s);
  assert(requests.member(rid), "unknown request");
  const r = requests.lookup(rid);
  assert(r.status == Status.pending, "already finalised");
  const c = committees.lookup(r.epoch);
  const u1 = c.t >= 2;
  const u2 = c.t >= 3;
  const u3 = c.t >= 4;
  assert(p[0] >= 1 && p[0] <= c.n, "the first position isn't in this committee");
  assert(u1 ? (p[1] > p[0] && p[1] <= c.n) : p[1] == 0, "positions: the committee's threshold of them, in increasing order, then zeros");
  assert(u2 ? (p[2] > p[1] && p[2] <= c.n) : p[2] == 0, "positions: the committee's threshold of them, in increasing order, then zeros");
  assert(u3 ? (p[3] > p[2] && p[3] <= c.n) : p[3] == 0, "positions: the committee's threshold of them, in increasing order, then zeros");
  // in increasing order, the k-th position has k others below it: c_i's sign is (-1)^k
  const g = ecAdd(ecAdd(term(true, rid, p[0], p[1], p[2], p[3], false), term(u1, rid, p[1], p[0], p[2], p[3], true)),
                  ecAdd(term(u2, rid, p[2], p[0], p[1], p[3], false), term(u3, rid, p[3], p[0], p[1], p[2], true)));
  const out = outputOf(g);
  if (finaliseBounty > 0 && r.fee >= finaliseBounty) {
    requests.insert(rid, Request { ...r, status: Status.fulfilled, output: out, fee: (r.fee - finaliseBounty) as Uint<128> });
    sendUnshielded(nativeToken(), finaliseBounty, toUser(disclose(bountyTo)));
  } else {
    requests.insert(rid, Request { ...r, status: Status.fulfilled, output: out });
  }
  return out;
}

// Position i of a request: whether it answered in time; if not, a miss is counted against it.
// Returns the operator seated there.
circuit tally(e: Uint<64>, i: Uint<8>, answered: Boolean): Bytes<32> {
  const id = members.lookup(seatKey(e, i));
  if (!answered) {
    const m = missed.member(id) ? missed.lookup(id) : 0;
    missed.insert(id, (m + 1) as Uint<16>);
  }
  return id;
}

// Anyone settles a request once its deadline has passed.
//  - It has its value: what it still holds of the fee, plus any penalties in the pot, is shared
//    equally by the seats that answered in time, to be claimed.
//  - It doesn't: it is void. The refund address gets the fee back, plus the miss penalty from the
//    bond of every seat that didn't answer in time. It keeps its H and can still be answered and
//    finalised, so going silent never buys a different value.
// Either way a miss is counted against each seat that didn't answer in time.
export circuit settle(id: Bytes<32>): [] {
  const rid = disclose(id);
  assert(requests.member(rid), "unknown request");
  const r = requests.lookup(rid);
  assert(!r.settled, "already settled");
  assert(blockTimeGte(r.deadline), "deadline has not passed");
  const c = committees.lookup(r.epoch);
  if (r.status == Status.fulfilled && r.timely > 0) {
    const total = ((r.fee as Field) + (pot as Field) * (collateralPerSlot as Field)) as Uint<128>;
    pot = 0;
    const each = disclose(quotient(total, r.timely));
    const left = ((total as Field) - (each as Field) * (r.timely as Field)) as Uint<128>;
    assert(left < r.timely, "that isn't the fee shared equally");
    dust = (dust + left) as Uint<128>;
    for (const k of 0..7) {
      const i = (k + 1) as Uint<8>;
      if (i <= c.n) {
        const answered = timelyShares.member(shareId(rid, i));
        const op = tally(r.epoch, i, answered);
        if (answered) {
          const had = earned.member(op) ? earned.lookup(op) : 0;
          earned.insert(op, (had + each) as Uint<128>);
        }
      }
    }
    requests.insert(rid, Request { ...r, settled: true, fee: 0 });
  } else {
    for (const k of 0..7) {
      const i = (k + 1) as Uint<8>;
      if (i <= c.n) {
        const answered = timelyShares.member(shareId(rid, i));
        const op = tally(r.epoch, i, answered);
        if (!answered && !bonds.lookup(op).lessThan(missPenalty)) {
          bonds.lookup(op).decrement(missPenalty);
          refunding = (refunding + slotsValue(missPenalty)) as Uint<128>;
        }
      }
    }
    const back = (r.fee + refunding) as Uint<128>;
    refunding = 0;
    if (back > 0) {
      sendUnshielded(nativeToken(), back, toUser(r.refundTo));
    }
    requests.insert(rid, Request { ...r, settled: true, voided: true, fee: 0 });
  }
}

// An operator takes what it has earned, to its payout address.
export circuit claim(): [] {
  const id = disclose(keyIdOf(ecMulGenerator(operatorSecret() as JubjubScalar)));
  assert(earned.member(id) && earned.lookup(id) > 0, "nothing to claim");
  const amount = earned.lookup(id);
  earned.insert(id, 0);
  sendUnshielded(nativeToken(), amount, toUser(operators.lookup(id).payout));
}

// ---------------------------------------------------------------- the recommended successor

// The seat at position i of the serving committee names the contract it recommends moving to
// (once per epoch). When two-thirds of the seats have named the same address, it is the
// epoch's; if the epoch served before this one named it too, it becomes the recommended
// successor. This records an opinion and nothing more: no bond, fee, request or seat moves.
export circuit recommend(i: Uint<8>, next: ContractAddress): [] {
  const ii = disclose(i);
  const to = disclose(next).bytes;
  assert(current > 0, "no committee is serving yet");
  const e = current;
  const c = committees.lookup(e);
  assert(ii >= 1 && ii <= c.n, "no such position");
  assert(disclose(same(ecMulGenerator(operatorSecret() as JubjubScalar), seats.lookup(seatKey(e, ii)))), "not this position's holder");
  assert(to != kernel.self().bytes, "that is this contract");
  assert(!ballots.member(seatKey(e, ii)), "this seat has named an address in this epoch");
  ballots.insert(seatKey(e, ii), true);
  const k = voteKey(e, to);
  const n = ((votes.member(k) ? votes.lookup(k) : 0) + 1) as Uint<8>;
  votes.insert(k, n);
  if (n * 3 >= c.n * 2 && backedEpoch != e) {
    if (previous > 0 && backedEpoch == previous && backed == to) {
      successor = to;
      successorEpoch = e;
    }
    backed = to;
    backedEpoch = e;
  }
}
