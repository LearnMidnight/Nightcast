# Copy this file to .env (next to compose.yml) and fill it in. Keep .env private.

# Your Blockfrost project id for Midnight Preprod (free at https://blockfrost.io: add a project,
# choose Midnight Preprod). Each operator should have its own: a project has a daily allowance.
NIGHTCAST_BLOCKFROST_PROJECT_ID=

# The proof server's memory ceiling (it needs about 5 GB for the largest proof).
# PROOF_SERVER_MEMORY=10g
