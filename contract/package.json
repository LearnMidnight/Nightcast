{
  "name": "@nightcast/contract",
  "version": "0.1.0",
  "description": "Nightcast: verifiable randomness for Midnight. The Compact contract (compiled, with proving keys), key helpers and an in-memory simulator. Experimental and unaudited: testnets only.",
  "keywords": [
    "midnight",
    "vrf",
    "verifiable-randomness",
    "randomness",
    "oracle",
    "zero-knowledge",
    "compact",
    "lottery",
    "raffle",
    "ai-agents",
    "simulator"
  ],
  "homepage": "https://github.com/LearnMidnight/Nightcast#readme",
  "bugs": {
    "url": "https://github.com/LearnMidnight/Nightcast/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LearnMidnight/Nightcast.git",
    "directory": "contract"
  },
  "license": "MIT",
  "author": "LearnMidnight",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "compact": "compact compile src/nightcast.compact src/managed/nightcast",
    "compact:fast": "compact compile --skip-zk src/nightcast.compact src/managed/nightcast",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -R src/managed dist/managed && cp src/nightcast.compact dist/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@midnight-ntwrk/zkir-v2": "2.1.0"
  }
}
