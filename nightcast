#!/usr/bin/env bash
# Run Nightcast's command-line tools from a checkout:
#   ./nightcast keygen <oracle|operator|requester> --out <file>
#   ./nightcast <deploy|accept-key|lock|verify|fingerprints|wallet|oracle|request|status> ...
# Build first: npm install && npm run compact && npm run build
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ ! -f "$DIR/deploy/dist/cli.js" ]; then
  echo "Nightcast isn't built yet. Run: npm install && npm run compact && npm run build" >&2
  exit 1
fi
# Fix the dust wallet's endless fee loop in the installed library (see the
# script for details). Quick, and does nothing once applied.
node "$DIR/deploy/scripts/patch-dust-fee-loop.mjs" --quiet || true
# Let Node use up to 3 GB unless told otherwise: syncing a Preprod wallet needs
# more than the default on small machines.
export NODE_OPTIONS="${NODE_OPTIONS:---max-old-space-size=3072}"
if [ "${1:-}" = "keygen" ]; then
  shift
  exec node "$DIR/sdk/dist/keygen.js" "$@"
fi
exec node "$DIR/deploy/dist/cli.js" "$@"
